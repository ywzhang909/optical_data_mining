# 原有配置（保留）
PYTHONPATH=D:\Projects\TIFO\data-mining\src

# 小系统激光打靶试验：内部计算假设参数。
# 这些数值只用于脚本内部计算与原始文本脱敏，不会写入任何报告或 CSV。
# 产物中统一使用文字描述（近红外波段 / 标准功率 / 低功率 / 有效光斑等）。

# 波长 [m]：原始数据未记录，按近红外常用波段典型值假设
XXT_LAMBDA_M=1.064e-6

# 功率档位 [W]：原始数据仅以档位名称记录
XXT_POWER_STD_W=5000
XXT_POWER_LOW_W=500

# 反演光斑几何缺省值（仅在无法由数据拟合时使用）
XXT_SPOT_D0_MM=9.5
XXT_SPOT_THETA_URAD=16.1
XXT_SPREAD_D0_MM=8.0
XXT_SPREAD_THETA_URAD=20.0
