# UV 环境变量配置
# 将此文件内容添加到您的环境变量中或复制到 .env 文件

# 设置UV链接模式为copy，避免硬链接警告
export UV_LINK_MODE=copy

# 设置UV缓存目录到项目内
export UV_CACHE_DIR=.uv/cache

# 设置UV Python下载目录
export UV_PYTHON_DOWNLOADS=.uv/python

# 设置UV配置目录
export UV_CONFIG_DIR=.uv

# 设置虚拟环境目录
export UV_VENV=.venv

# 其他有用的UV环境变量
# export UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# export UV_CONCURRENT_DOWNLOADS=4
# export UV_PREFER_BINARY=true